# ---------------------------------------------------------------------------
# Planning / agent artifacts - MUST NEVER be published.
# .omo/ holds ulw-plan drafts, the work plan and evidence.
# .codegraph/ holds a machine-local code index (its own .gitignore also guards
# the database, but we exclude the whole tool directory from the public repo).
# ---------------------------------------------------------------------------
.omo/
.codegraph/

# AGENTS.md is agent material, not a deliverable. It stays on the developer's disk
# (the agent reads it), but it must never be published: remove it from the index with
# `git rm --cached AGENTS.md` if it ever reappears, and this line then keeps it out.
AGENTS.md

# ---------------------------------------------------------------------------
# CraftOS-PC scratch data (headless test runs use --directory <fresh-tmp>).
# ---------------------------------------------------------------------------
craftos-data/
craftos-pc/
*.craftos/
**/computer/*/disk/

# ---------------------------------------------------------------------------
# Python (fixture generation / audio cross-check tooling: pynbs, nbswave).
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------------------
# Lua test scratch output.
# ---------------------------------------------------------------------------
*.tmp

# ---------------------------------------------------------------------------
# 本地测试套件：仅保留在本机，不随公开仓库发布。
# ---------------------------------------------------------------------------
tests/

# ---------------------------------------------------------------------------
# OS / editor cruft.
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/
